@model examen.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesion";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h1 class="h3 text-center mb-4">Iniciar sesion</h1>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"])" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>

                <div class="alert alert-info mt-4 mb-0">
                    Usuario inicial:
                    <strong>admin@examen.com</strong><br />
                    Contrasena:
                    <strong>Admin123*</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
